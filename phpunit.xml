<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="vendor/autoload.php"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Database tests">
            <directory>./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Existing PDO processor tests -->
        <env name="TEST_TOBENTO_DATABASE_PDO_MYSQL" value="false" />
        <env name="TEST_TOBENTO_DATABASE_PDO_MYSQL_DSN" value="mysql:host=localhost;dbname=tobento_database_test" />
        <env name="TEST_TOBENTO_DATABASE_PDO_MYSQL_USERNAME" value="root" />
        <env name="TEST_TOBENTO_DATABASE_PDO_MYSQL_PASSWORD" value="" />

        <!-- NEW: Dumper tests -->
        <env name="TEST_TOBENTO_DATABASE_MYSQL_DUMPER" value="false" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_DSN" value="mysql:host=localhost;dbname=tobento_database_test" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_NAME" value="tobento_database_test" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_HOST" value="127.0.0.1" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_USER" value="root" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_PASSWORD" value="" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_PORT" value="3306" />
        <env name="TEST_TOBENTO_DATABASE_MYSQL_SOCKET" value="" />
    </php>
</phpunit>